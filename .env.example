# Optional overrides. Copy to `.env.local` to use.
# Content lives in src/constants/ — these are deployment-time knobs only.

# WhatsApp number in full international format, digits only (no +, no spaces).
# Australian example: 61412345678
# If unset, the value in src/constants/site.ts is used.
VITE_WHATSAPP_NUMBER=

# Canonical site origin, used for absolute URLs in metadata.
VITE_SITE_URL=https://magicalhoopart.example
