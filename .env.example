# Optional overrides. Copy to `.env.local` to use.
# Content lives in src/constants/ — these are deployment-time knobs only.

# WhatsApp number in full international format, digits only (no +, no spaces).
# Australian example: 61412345678
# If unset, the value in src/constants/site.ts is used.
VITE_WHATSAPP_NUMBER=

# Canonical site origin — no trailing slash.
#
# REQUIRED FOR LINK PREVIEWS. Open Graph needs absolute URLs, so this is what
# makes the og:image resolve when the site is shared on WhatsApp, Facebook,
# Instagram or iMessage. `pnpm build` warns if it is unset.
VITE_SITE_URL=https://magicalhoopart.com
